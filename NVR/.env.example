# Camera-tower MiniPC service: the ONE config file for everything, discovery included.
# Copy to Backend/NVR/.env (or point NVR_ENV_FILE at another file).
# Real environment variables override this file.

MINIPC_DB_PATH=/var/lib/nvr/nvr.sqlite3
MINIPC_BIND_HOST=0.0.0.0
MINIPC_PORT=8000

# Jetson HTTP API (Jetson must use DISCOVERY_ENABLED=false).
JETSON_BASE_URL=http://192.168.1.20:8080
JETSON_TIMEOUT_S=30

# ---------------------------------------------------------------------------
# MediaMTX relay on this MiniPC (always on). Run it with NVR/mediamtx.yml.
# ---------------------------------------------------------------------------
MEDIAMTX_API_URL=http://127.0.0.1:9997
MEDIAMTX_API_USER=nvr-reader
MEDIAMTX_API_PASSWORD=Ycn4ufni2026!
# Required. Same reader password as mediamtx.yml, URL-encoded. Address reachable
# from cloud (VPN or forwarded TCP port). Cloud MediaMTX pulls these URLs.
NVR_PUBLIC_RTSP_BASE_URL=rtsp://nvr-reader:Ycn4ufni2026!@tower.example.com:8554
# MediaMTX RTSP URL on the MiniPC LAN, used by Jetson to read video.
# Use the MiniPC IP here. JETSON_BASE_URL above is the Jetson HTTP API.
# Empty = use NVR_PUBLIC_RTSP_BASE_URL.
MEDIAMTX_LAN_RTSP_BASE_URL=rtsp://nvr-reader:Ycn4ufni2026!@192.168.1.10:8554

# Stream 1 records continuously on the tower; stream 2 serves live view/AI.
RECORDING_ENABLED=true
RECORDING_PLAYBACK_URL=http://127.0.0.1:9996
RECORDING_DIRECTORY=/var/lib/nvr/recordings
RECORDING_RETENTION=168h
RECORDING_CLIP_DIRECTORY=/var/lib/nvr/clips
RECORDING_CLIP_RETENTION_S=604800
RECORDING_MAX_EXPORTS=2
RECORDING_MAX_PENDING=16
RECORDING_MAX_CLIP_BYTES=536870912
# Browser-reachable HTTPS gateway base; /api suffix is optional.
RECORDING_PUBLIC_BASE_URL=https://tower.example.com/api
# Set a random secret (at least 32 characters); cloud NVR_RECORDING_API_KEY matches.
RECORDING_API_KEY=

# ---------------------------------------------------------------------------
# Discovery
# ---------------------------------------------------------------------------
DISCOVERY_ENABLED=true
DISCOVERY_INTERVAL_S=60
# Sweeps absent before a missing alert. Minimum 2.
DISCOVERY_MISS_THRESHOLD=2
# Look for direct cameras on the LAN (WS-Discovery + subnet sweep).
DISCOVERY_LOCAL_ENABLED=true
# Comma-separated. Empty = the /24 of this host's IPv4. /16 at most.
DISCOVERY_SUBNETS=

# Direct LAN cameras.
HIK_USERNAME=admin
HIK_PASSWORD=
HIK_RTSP_PORT=554
HIK_HTTP_PORT=80
# 1 = main, 2 = sub. Sub is right for detection.
HIK_RTSP_STREAM=2

# ---------------------------------------------------------------------------
# The tower's NVR: EITHER this MiniPC (leave NVR_HOST empty) OR exactly one
# physical Hikvision NVR (set NVR_HOST). Direct LAN cameras are found either way;
# a camera seen both directly and via the NVR is merged into one.
# ---------------------------------------------------------------------------
NVR_HOST=
NVR_RTSP_PORT=554
NVR_HTTP_PORT=80
# Empty = every enabled channel the NVR's ISAPI reports.
# Set (e.g. 1-16 or 1-4,8) = only these channels, kept as RTSP candidates even
# when the NVR's ISAPI (HTTP) is unreachable.
NVR_CHANNELS=
# Empty NVR_USERNAME = use HIK_USERNAME / HIK_PASSWORD.
NVR_USERNAME=
NVR_PASSWORD=
NVR_CHANNEL_OFFSET=0

# A camera reachable both directly and through the NVR: which route wins.
SOURCE_PREFERENCE=direct

# ---------------------------------------------------------------------------
# Frame verification: ffmpeg must decode one frame before a camera is adopted.
# ---------------------------------------------------------------------------
FFMPEG_BIN=ffmpeg
VERIFY_TIMEOUT_S=12
VERIFY_CONCURRENCY=4
# Recorders cap concurrent RTSP sessions; keep this low.
VERIFY_PER_HOST=2
