# =============================================================================
# Jetson TensorRT inference service — .env for yolo26m
#
# Copy to .env ON THE JETSON:   cp .env.yolo26m .env
#
# yolo26m is the accuracy-first option. On the bus.jpg test it found 5 distinct
# objects (3 people + a truck + a partial person) where yolo26s found 1 — a real
# difference on busy scenes. You pay for it in throughput: yolo26m is ~2x the
# weights and roughly 2-2.5x the compute of yolo26s.
#
# >>> DEFAULT_SAMPLE_FPS BELOW IS A PLACEHOLDER. <<<
# Run the throughput gate first and set it from the measured number:
#     ./deployment/build_engine.sh   (MODEL=yolo26m)
#     images/sec = 10000 / GPU_Compute_Mean_ms
#     DEFAULT_SAMPLE_FPS = images_per_sec / camera_count   (round DOWN)
# Expect roughly 30-45 img/s on an Orin Nano => ~3-4 fps/cam across 10 cameras.
# If pool_evicted_total in /health climbs steadily, this is still too high.
# =============================================================================

DET_ENGINE=./models/yolo26m.engine

# --- Inference settings -------------------------------------------------------
# Must match the engine build. The service refuses to start on a mismatch.
IMG_SZ=640

# Must stay <= the cloud tracker's low_th (0.20) so its second-stage association
# has low-confidence boxes to re-link a flickering object with.
CONF=0.35
IOU=0.45
CUDA_DEVICE=0
NMS_TOPK=50

# Collapse one vehicle scored as both "car" and "truck" into a single box. This
# matters MORE on yolo26m than on yolo26s: a more accurate model finds more
# objects per scene, and the engine's baked-in end-to-end NMS is per-class, so
# it cannot suppress a cross-class pair itself. See .env.example for the full
# rationale and tuning notes.
DEDUPE_CROSS_CLASS=true
DEDUPE_IOU=0.55
DEDUPE_OVERLAP=0.70
DEDUPE_SIZE_RATIO=0.65

ALLOWED_CLASSES=person,car,motorcycle,truck

# --- Batched inference --------------------------------------------------------
# Must be <= the engine's maxShapes batch. Verify `max_batch` in /health after
# switching: if it reads 1, you are on a static-batch engine and cross-camera
# batching is doing nothing.
INFER_MAX_BATCH=10

# Top-up window, used only when the pool is underfilled (idle / cold start).
INFER_BATCH_LINGER_MS=10

# --- Frame pool ---------------------------------------------------------------
# When full, the camera holding the MOST frames loses its OLDEST one, so a busy
# camera pays for a newcomer's frame and quiet cameras are never starved.
FRAME_POOL_CAP=30

# Frames older than this are dropped instead of inferred. Raised from 700ms for
# yolo26m: a slower model means a frame legitimately waits longer for a GPU slot,
# and at ~3-4 fps/cam a 700ms cutoff would discard frames that are still useful.
FRAME_MAX_AGE_MS=1000

# --- Throughput ---------------------------------------------------------------
# PLACEHOLDER — replace with your measured value (see header).
DEFAULT_SAMPLE_FPS=6
MAX_SAMPLE_FPS=10

DEFAULT_RESIZE_W=640
DEFAULT_RESIZE_H=480

# --- Queues / workers ---------------------------------------------------------
CHANNEL_OUT_Q_MAX=1
INFER_QUEUE_MAX=1
# MAX_INFLIGHT_FRAMES=40

# On a SINGLE GPU one worker running one large batch beats several workers
# running smaller ones (multiple CUDA contexts time-slice and fragment batches).
INFER_NUM_WORKERS=1
INFER_NUM_WORKERS_MAX=2

# Leak guard for frames whose result never arrives. A timeout no longer discards
# the frame (a late result is still delivered), so this can be generous. Raised
# for yolo26m because a full 10-wide batch legitimately takes longer.
INFER_RESULT_TIMEOUT_S=4.0

# --- Live-overlay behaviour ---------------------------------------------------
# Keep true: the cloud tracker ages tracks by frame arrival, so it must see the
# frames where an object is absent.
EMIT_EMPTY_DETECTIONS=true

# Failed frames carry no detections; forwarding them makes the tracker treat a
# GPU hiccup as "everything vanished". Counted in /health, not broadcast.
EMIT_FAILED_EVENTS=false

# --- Snapshot cache -----------------------------------------------------------
SNAPSHOT_ON_DETECTION_ONLY=true
SNAPSHOT_MIN_INTERVAL_MS=1000
ENABLE_SNAPSHOT_CACHE=true
SNAPSHOT_MAX_EDGE=640
SNAPSHOT_JPEG_QUALITY=65

PORT=8080
