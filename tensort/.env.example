# =============================================================================
# Jetson TensorRT inference service — .env
# Tuned for ~10 cameras on an Orin Nano (8 GB) running yolo26s @ 640, FP16.
#
# This file is loaded two ways: systemd passes it via EnvironmentFile, and
# main.py also calls load_dotenv() so `python3 main.py` behaves the same.
# Already-set environment variables always win over this file.
#
# Golden rule: do NOT sample faster than the GPU can drain. Demanding more FPS
# than the engine sustains does not make the overlay smoother — frames pile up,
# get evicted, and the overlay drifts behind the live video.
# =============================================================================

# TensorRT engine path (relative to Backend/tensort).
# Swap to ./models/yolo26n.engine to roll back to the smaller/faster model.
DET_ENGINE=./models/yolo26s.engine

# --- Inference settings -------------------------------------------------------
# IMG_SZ MUST match the input size baked into DET_ENGINE at export time. The
# service now refuses to start on a mismatch instead of failing every frame.
IMG_SZ=640

# CONF must sit BELOW the cloud tracker's low_th (0.20) so the tracker's
# second-stage association has low-confidence boxes to re-link a flickering
# object with. Filtering at 0.30+ here starved that band and was a direct cause
# of boxes blinking out between frames.
CONF=0.30
IOU=0.45
CUDA_DEVICE=0
NMS_TOPK=50

# --- Cross-class duplicate suppression ---------------------------------------
# One vehicle is routinely scored as BOTH "car" and "truck", which leaves this
# service as TWO boxes on one object — downstream that is two drawn boxes and
# two track ids on something that never moved.
#
# Neither NMS path above prevents it: nms_xyxy runs on a single argmax score per
# box (it never sees the same object under two labels), and the yolo26 engines
# use END-TO-END NMS baked in at export time, which is PER-CLASS by
# construction and never calls nms_xyxy at all.
#
# This pass collapses boxes whose labels are confusable (car/truck/bus/van) and
# whose geometry says they are one object. Defaults mirror the cloud's
# DETECTION_NMS_* so both ends agree on what a duplicate is — change them
# together or not at all.
DEDUPE_CROSS_CLASS=true
# Classic NMS arm: heavy mutual overlap.
DEDUPE_IOU=0.55
# Offset-duplicate arm: intersection-over-SMALLER-area, plus a size-similarity
# floor so a small car inside a truck's box is NOT merged. Lowering these merges
# more aggressively — two genuinely occluding vehicles (IoU ~0.6) are
# geometrically close to a loose duplicate, so move in small steps and verify on
# real footage. Drawing two boxes on one car is a milder failure than dropping a
# real vehicle.
DEDUPE_OVERLAP=0.70
DEDUPE_SIZE_RATIO=0.65

# Classes to emit (COCO names, comma-separated).
ALLOWED_CLASSES=person,car,motorcycle,truck

# --- Batched inference (multi-camera throughput) -----------------------------
# Cameras push frames into a shared FramePool; the dispatcher draws up to
# INFER_MAX_BATCH of them (round-robin across cameras, oldest first) and runs
# them as ONE (B,3,H,W) GPU call. A batch never waits for all cameras, and one
# camera may fill several slots when the others are quiet.
#
# REQUIRES a dynamic-batch engine. Re-export + rebuild (10-wide for 10 cams):
#   yolo export model=yolo26s.pt format=onnx dynamic=True imgsz=640 simplify=True
#   trtexec --onnx=yolo26s.onnx --saveEngine=yolo26s.engine --fp16 \
#     --minShapes=images:1x3x640x640 \
#     --optShapes=images:10x3x640x640 \
#     --maxShapes=images:10x3x640x640
#
# CRITICAL: INFER_MAX_BATCH must be <= the engine's maxShapes batch. If they
# disagree run_batch silently splits (an 8-wide engine fed 10 frames does 8+2,
# two GPU calls). Check `max_batch` in /health.
INFER_MAX_BATCH=10

# Top-up window, used ONLY when the pool is underfilled (idle / cold start). In
# steady state the pool has already accumulated frames while the GPU was busy,
# so batches fill without waiting. Keep this small.
INFER_BATCH_LINGER_MS=10

# --- Frame pool ---------------------------------------------------------------
# How many frames may wait for the GPU. When full, the camera holding the MOST
# frames loses its OLDEST one, so a busy camera pays for a newcomer's frame and
# quiet cameras are never starved. If every camera holds one frame, the globally
# oldest goes.
FRAME_POOL_CAP=30

# Frames older than this are dropped instead of inferred — a stale detection is
# rejected by the tracker anyway and would waste a GPU slot.
FRAME_MAX_AGE_MS=700

# --- Throughput tuning for multi-camera load ---------------------------------
# DEFAULT_SAMPLE_FPS is the single most important knob. Budget:
#   yolo26s @640 FP16 on an Orin Nano sustains roughly 65-100 images/sec in a
#   10-wide batch. With 10 cameras that is ~6.5-10 fps/cam. Measure YOUR engine
#   first (see ARCHITECTURE.md "Throughput gate") and set this to what it can
#   actually drain. If pool_evicted_total in /health climbs steadily, lower it.
DEFAULT_SAMPLE_FPS=10
MAX_SAMPLE_FPS=12

# Pre-resize frames in the channel thread before inference. Cuts 1080p from
# ~6 MB to ~700 KB per frame — important for memory under many cameras. 0 = off.
DEFAULT_RESIZE_W=640
DEFAULT_RESIZE_H=480

# Per-camera hand-off queue (capture thread -> event loop); 1 = keep newest.
CHANNEL_OUT_Q_MAX=1

# Worker job queue depth: 1 batch executing + 1 queued. The dispatcher waits for
# a free slot before drawing frames, so surplus load is shed in the FramePool
# (fairly, per camera) rather than dropped a whole batch at a time.
INFER_QUEUE_MAX=1

# Safety cap on in-flight frames. Bounded by construction now; leave unset to
# auto-scale to max(8, batch*4).
# MAX_INFLIGHT_FRAMES=40

# Worker pool: 0 = auto-size to camera count (capped by INFER_NUM_WORKERS_MAX).
# On a SINGLE GPU, ONE worker running one large batch beats several workers
# running smaller batches (multiple CUDA contexts time-slice the same GPU and
# fragment the batches). Keep this at 1 unless you benchmark otherwise.
INFER_NUM_WORKERS=2
INFER_NUM_WORKERS_MAX=2

# Leak guard for frames whose result never arrives. A timeout no longer discards
# the frame — if the GPU returns late, the result is still delivered — so this
# can be generous. Keep it above your worst-case batch time.
INFER_RESULT_TIMEOUT_S=3.0

# --- Live-overlay behaviour ---------------------------------------------------
# EMIT_EMPTY_DETECTIONS=true streams a result for EVERY camera on EVERY frame,
# even when nothing is detected. Keep this TRUE: the cloud tracker ages tracks by
# frame arrival, so it must see the frames where an object is absent. With it
# off, a disappearance looks like a stalled stream and tracks coast instead of
# expiring.
EMIT_EMPTY_DETECTIONS=true

# Failed/timed-out frames carry no detections. Forwarding them makes the tracker
# treat a transient GPU hiccup as "everything vanished", so they are logged and
# counted (infer_fail in /health) but not broadcast. Turn on only for debugging.
EMIT_FAILED_EVENTS=false

# --- Snapshot cache -----------------------------------------------------------
SNAPSHOT_ON_DETECTION_ONLY=true
SNAPSHOT_MIN_INTERVAL_MS=1000
ENABLE_SNAPSHOT_CACHE=true
SNAPSHOT_MAX_EDGE=640
SNAPSHOT_JPEG_QUALITY=65

# =============================================================================
# Transport note (read if scaling past ~10 cameras or running high FPS):
# This service is launched with Flask's Werkzeug dev server (app.run threaded).
# It is single-process and not built for many concurrent long-lived SSE streams.
# With EMIT_EMPTY_DETECTIONS=true the cloud opens one SSE PER camera, so load on
# this server is high. For real scale, serve via gunicorn/waitress, or have the
# cloud consume the single /cameras/detections/stream instead of N per-camera
# connections.
# =============================================================================
