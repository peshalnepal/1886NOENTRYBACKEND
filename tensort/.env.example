# Jetson Orin Nano 8 GB: starting profile for up to eight cameras, yolo26m.
# Benchmark the actual device before increasing FPS. Existing .env files are
# not overwritten automatically; copy these settings deliberately on upgrade.
#
# Build the engine ON THE JETSON first:
#     MODEL=yolo26m MAX_BATCH=8 ./deployment/build_engine.sh
DET_ENGINE=./models/yolo26m.engine
IMG_SZ=640

# CONF must sit BELOW the cloud tracker's low_th (0.20) so its second-stage
# association still has low-confidence boxes to re-link a flickering object
# with. 0.20 sits exactly AT low_th; 0.18 leaves a margin.
CONF=0.18
IOU=0.45
CUDA_DEVICE=0
NMS_TOPK=50
ALLOWED_CLASSES=person,car,motorcycle,truck
DEDUPE_CROSS_CLASS=true
DEDUPE_IOU=0.55
DEDUPE_OVERLAP=0.70
DEDUPE_SIZE_RATIO=0.65

# Enabled-camera admission limit. Benchmark increases.
MAX_CAMERAS=8
# One GPU worker preserves per-camera ordering and shares one engine.
INFER_NUM_WORKERS=1
INFER_MAX_BATCH=8
INFER_BATCH_LINGER_MS=10
INFER_QUEUE_MAX=1
# Upper bound on pending inference; FRAME_MAX_AGE_MS also applies.
# Set to 0 to disable this timeout, while retaining the frame-age budget.
INFER_RESULT_TIMEOUT_S=4.0

# Two waiting batches plus one executing and one queued batch.
FRAME_POOL_CAP=16
# Raised from 700 for yolo26m: a slower model means a frame legitimately waits
# longer for a GPU slot, and at ~3 fps/cam a 700ms cutoff would discard frames
# that are still useful.
FRAME_MAX_AGE_MS=1000
CHANNEL_OUT_Q_MAX=1

# PROVISIONAL — yolo26m is roughly 2-2.5x the compute of yolo26s, so expect very
# roughly 30-45 img/s at 640 FP16 on an Orin Nano => ~3-4 fps/cam across eight
# cameras. Replace with the measured number from build_engine.sh's throughput
# gate: DEFAULT_SAMPLE_FPS = floor((MAX_BATCH*1000 / GPU_Compute_Mean_ms) / 8).
# If pool_evicted_total in /health climbs steadily, this is too high.
DEFAULT_SAMPLE_FPS=3
MAX_SAMPLE_FPS=8
DEFAULT_RESIZE_W=640
DEFAULT_RESIZE_H=360
OPENCV_NUM_THREADS=1

# Empty results keep cloud track aging correct; failures are counted locally.
EMIT_EMPTY_DETECTIONS=true
EMIT_FAILED_EVENTS=false

# At most one pending JPEG per camera and one encoding thread for the device.
ENABLE_SNAPSHOT_CACHE=true
SNAPSHOT_ON_DETECTION_ONLY=true
SNAPSHOT_MIN_INTERVAL_MS=1000
SNAPSHOT_MAX_EDGE=640
SNAPSHOT_JPEG_QUALITY=65

# Cameras are registered by the NVR gateway through POST /cameras.

# Space capture attempts without delaying eight-camera startup by 42 seconds.
CAMERA_START_STAGGER_S=1.5
# Reconnect silent native captures after this many seconds without a frame.
# Low sample rates receive at least three frame intervals of grace.
CAPTURE_STALL_TIMEOUT_S=5
