# TensorRT engine paths (relative to Backend/tensort)
DET_ENGINE=./models/yolov8n.engine

# Inference settings
IMG_SZ=640
CONF=0.50
IOU=0.45
CUDA_DEVICE=0

# Throughput tuning for multi-camera load
DEFAULT_SAMPLE_FPS=3.0
INFER_QUEUE_MAX=8
CHANNEL_OUT_Q_MAX=4
PIPELINE_OUT_QUEUE_MAX=500
PENDING_KEY_MAX=1000
PIPELINE_LOG_EVERY_N_FRAMES=0

# Snapshot / thumbnail
# Only update the snapshot cache on frames that have detections.
# This ensures the Azure backend always fetches a frame showing the detected object,
# not a later empty frame (fixes the thumbnail timing gap).
SNAPSHOT_ON_DETECTION_ONLY=true
SNAPSHOT_MIN_INTERVAL_MS=0
ENABLE_SNAPSHOT_CACHE=true
