# TensorRT engine paths (relative to Backend/tensort)
DET_ENGINE=./models/yolo26n.engine

# Inference settings
IMG_SZ=640
CONF=0.350
IOU=0.45
CUDA_DEVICE=0
NMS_TOPK=50

# Throughput tuning for multi-camera load
# On Jetson Nano (2-3 GB RAM), keep sample FPS low to avoid memory pressure.
# Higher FPS = more frames in memory = more RAM = swap thrashing.
DEFAULT_SAMPLE_FPS=5
MAX_SAMPLE_FPS=15
MAX_CAMERAS=10

# 0 = disabled — TRT letterbox handles any input, pre-resize is wasted work
DEFAULT_RESIZE_W=0
DEFAULT_RESIZE_H=0

# Per-worker queue depth: 1 drops stale frames immediately instead of queuing them
CHANNEL_OUT_Q_MAX=1
INFER_QUEUE_MAX=1
PENDING_KEY_MAX=32
PIPELINE_OUT_QUEUE_MAX=64

# Safety cap on in-flight frames. Must be >= number of cameras so every camera
# gets a fair shot at inference each cycle. The worker queue (INFER_QUEUE_MAX)
# is the real memory guard — only 2 frames in the worker at a time.
# For 5 cameras, 8 is a safe cap.
MAX_INFLIGHT_FRAMES=8

# Worker pool: 0 = auto. Defaults are conservative for low-RAM Jetsons.
INFER_NUM_WORKERS=0
INFER_NUM_WORKERS_MAX=1

# Nano-safe inference watchdog
INFER_RESULT_TIMEOUT_S=2.0

# Snapshot cache — reduce max edge to 640 on Nano to cut JPEG encode memory+CPU
SNAPSHOT_ON_DETECTION_ONLY=true
SNAPSHOT_MIN_INTERVAL_MS=1000
ENABLE_SNAPSHOT_CACHE=true
SNAPSHOT_MAX_EDGE=640
SNAPSHOT_JPEG_QUALITY=65
