# TensorRT engine paths (relative to Backend/tensort)
DET_ENGINE=./models/yolov8n.engine

# Inference settings
IMG_SZ=640
CONF=0.350
IOU=0.45
CUDA_DEVICE=0
NMS_TOPK=50

# Throughput tuning for multi-camera load
DEFAULT_SAMPLE_FPS=15
MAX_SAMPLE_FPS=25
MAX_CAMERAS=10

# 0 = disabled — TRT letterbox handles any input, pre-resize is wasted work
DEFAULT_RESIZE_W=0
DEFAULT_RESIZE_H=0

# Per-worker queue depth: 1 drops stale frames immediately instead of queuing them
CHANNEL_OUT_Q_MAX=1
INFER_QUEUE_MAX=1
PENDING_KEY_MAX=32
PIPELINE_OUT_QUEUE_MAX=64

# Worker pool: 0 = auto. Defaults are conservative for low-RAM Jetsons.
INFER_NUM_WORKERS=0
INFER_NUM_WORKERS_MAX=1

# Nano-safe inference watchdog
INFER_RESULT_TIMEOUT_S=2.0

# Snapshot cache
SNAPSHOT_ON_DETECTION_ONLY=true
SNAPSHOT_MIN_INTERVAL_MS=500
ENABLE_SNAPSHOT_CACHE=true
SNAPSHOT_MAX_EDGE=960
SNAPSHOT_JPEG_QUALITY=75
