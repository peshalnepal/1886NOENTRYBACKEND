# TensorRT engine paths (relative to Backend/tensort)
DET_ENGINE=./models/yolo26n.engine

# Inference settings
IMG_SZ=640
CONF=0.350
IOU=0.45
CUDA_DEVICE=0

# Throughput tuning for multi-camera load
DEFAULT_SAMPLE_FPS=6
MAX_SAMPLE_FPS=10
MAX_CAMERAS=10

DEFAULT_RESIZE_W=640
DEFAULT_RESIZE_H=360

CHANNEL_OUT_Q_MAX=1
INFER_QUEUE_MAX=2
PENDING_KEY_MAX=32
PIPELINE_OUT_QUEUE_MAX=64

SNAPSHOT_ON_DETECTION_ONLY=1
SNAPSHOT_MIN_INTERVAL_MS=500
INFER_RESULT_TIMEOUT_S=3.0

SNAPSHOT_ON_DETECTION_ONLY=true
SNAPSHOT_MIN_INTERVAL_MS=0
ENABLE_SNAPSHOT_CACHE=true
