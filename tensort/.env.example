# =============================================================================
# Jetson TensorRT inference service — .env
# Tuned for ~10 cameras on an Orin Nano (8 GB) running yolo26n @ 640, FP16.
#
# Golden rule learned the hard way: do NOT sample faster than the GPU can drain.
# One worker on one GPU sustains only so many images/sec (see DEFAULT_SAMPLE_FPS
# below). Demanding more does not make the overlay smoother — it backlogs the
# queue, drops frames, and pushes the overlay BEHIND the live video. More FPS
# past the GPU ceiling = LESS realtime.
# =============================================================================

# TensorRT engine path (relative to Backend/tensort)
DET_ENGINE=./models/yolo26n.engine

# --- Inference settings -------------------------------------------------------
# IMG_SZ MUST match the input size baked into DET_ENGINE at export time. The
# C,H,W dims are fixed in the engine; a mismatch makes infer() raise at runtime.
# To run at 640 you must FIRST re-export the engine at 640, then set this to 640.
IMG_SZ=640

# CONF: keep this realistic. 0.10 floods false positives (every shadow becomes a
# detection), which also adds load — more boxes to NMS, serialize, draw, notify.
# 0.25–0.35 is the sane range. 0.30 is a good default.
CONF=0.30
IOU=0.45
CUDA_DEVICE=0
NMS_TOPK=50

# --- Batched inference (multi-camera throughput) -----------------------------
# The dispatcher pulls the freshest frame from up to INFER_MAX_BATCH DISTINCT
# cameras (the coalescing buffer holds one per camera) within an
# INFER_BATCH_LINGER_MS window, and runs them as ONE (B,3,H,W) GPU call. This is
# real cross-channel batching: it raises TOTAL fps across cameras. It does NOT
# lower per-camera latency — the linger window adds a small fixed wait.
#
# REQUIRES a dynamic-batch engine. Re-export + rebuild, e.g. (10-wide for 10 cams):
#   yolo export model=yolo26n.pt format=onnx dynamic=True imgsz=640 simplify=True
#   trtexec --onnx=yolo26n.onnx --saveEngine=yolo26n.engine --fp16 \
#     --minShapes=images:1x3x320x320 \
#     --optShapes=images:6x3x320x320 \
#     --maxShapes=images:10x3x320x320
#
# CRITICAL: INFER_MAX_BATCH must be <= the engine's maxShapes batch. If they
# disagree, run_batch silently splits (e.g. an 8-wide engine fed 10 frames does
# 8+2, two GPU calls). Check `max_batch` in /health — if it says 8 but you set
# 10 here, rebuild the engine at 10x (above) or drop this to 8.
INFER_MAX_BATCH=10

# Linger window. At DEFAULT_SAMPLE_FPS=12 a 30 ms window still gathers most
# cameras into one batch while keeping added latency low. Larger = fuller
# batches but more latency; smaller = lower latency but thinner batches.
INFER_BATCH_LINGER_MS=30

# --- Throughput tuning for multi-camera load ---------------------------------
# DEFAULT_SAMPLE_FPS is the single most important knob. Budget:
#   one worker sustains ~150-170 images/sec aggregate (yolo26n @640 FP16, Orin
#   Nano, batch ~10 ≈ 58 ms/call). With 10 cameras that is ~15 fps/cam at the
#   absolute ceiling — so target 12 for headroom. Raising this to 30 demands
#   300 fps, ~2x over the ceiling: it drops ~40% of frames and lags the overlay.
#   Watch infer_dropped in /health — it must stay at/near 0. If it climbs, lower
#   this until it stops.
DEFAULT_SAMPLE_FPS=12
MAX_SAMPLE_FPS=15
# NOTE: MAX_CAMERAS is NOT read by any code — camera count is an operational
# limit, not an enforced one. Kept for documentation only.
MAX_CAMERAS=10

# Pre-resize frames in the channel thread before inference. Cuts 1080p from
# ~6 MB to ~700 KB per frame — important for memory under many cameras. 0 = off.
DEFAULT_RESIZE_W=640
DEFAULT_RESIZE_H=480

# Per-worker queue depth. With batching the worker queue auto-grows to at least
# INFER_MAX_BATCH so frames can accumulate into a batch; this is the floor.
# 1 means "drop stale frames once the batch-sized queue is full".
CHANNEL_OUT_Q_MAX=1
INFER_QUEUE_MAX=1
PENDING_KEY_MAX=32
PIPELINE_OUT_QUEUE_MAX=64

# Safety cap on in-flight frames. With batching this must be large enough to
# keep the worker's batch fed. Leave unset to auto-scale to max(8, batch*4).
# MAX_INFLIGHT_FRAMES=40

# Worker pool: 0 = auto-size to camera count (capped by INFER_NUM_WORKERS_MAX).
# On a SINGLE GPU, ONE worker running one large batch beats several workers
# running smaller batches (multiple CUDA contexts time-slice the same GPU and
# fragment the batches). Keep this at 1 unless you benchmark otherwise.
INFER_NUM_WORKERS=1
INFER_NUM_WORKERS_MAX=2

# Inference watchdog: fail a frame that hasn't returned in this long so its
# future never hangs. Keep above your worst-case batch time.
INFER_RESULT_TIMEOUT_S=2.0

# --- Live-overlay behaviour ---------------------------------------------------
# EMIT_EMPTY_DETECTIONS=true streams a result for EVERY camera on EVERY frame,
# even when nothing is detected. This is what makes all panels feel "realtime"
# (they refresh continuously instead of freezing until something appears).
# Cost: the SSE feed goes from sparse to ~DEFAULT_SAMPLE_FPS * cameras msgs/sec,
# so keep the FPS sane (above) and make sure the consumer routes by camera_uuid.
# Set to false if you only want event-driven (detection-only) updates.
EMIT_EMPTY_DETECTIONS=true

# --- Snapshot cache -----------------------------------------------------------
SNAPSHOT_ON_DETECTION_ONLY=true
SNAPSHOT_MIN_INTERVAL_MS=1000
ENABLE_SNAPSHOT_CACHE=true
SNAPSHOT_MAX_EDGE=640
SNAPSHOT_JPEG_QUALITY=65

# =============================================================================
# Transport note (read if scaling past ~10 cameras or running high FPS):
# This service is launched with Flask's Werkzeug dev server (app.run threaded).
# It is single-process and not built for many concurrent long-lived SSE streams.
# With EMIT_EMPTY_DETECTIONS=true the cloud opens one SSE PER camera, so load on
# this server is high. For real scale, serve via gunicorn/waitress, or have the
# cloud consume the single /cameras/detections/stream instead of N per-camera
# connections.
# =============================================================================
